# Keep this ON while developing the app UI and quiz logic.
# In demo mode, the app does NOT call OpenAI or Claude.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Later, when you want real AI generation, set DEMO_MODE=false
# and add one provider key below.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Alternative provider for later:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

MAX_UPLOAD_MB=15
