{
  "name": "cognify-examcrush",
  "version": "1.0.0",
  "private": true,
  "description": "Adaptive AI exam preparation app: upload notes, scan knowledge, drill weak spots, and finish with a final challenge.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.9",
    "openai": "^6.45.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.9"
  }
